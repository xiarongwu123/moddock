[Unit]
Description=MODDOCK private Nexus download API
Wants=moddock-nexus-browser.service
After=network.target moddock-nexus-browser.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/xrw/moddock-nexus/app
ExecStartPre=/bin/bash /home/xrw/moddock-nexus/app/platform/allow-worker-network.sh --apply
ExecStart=/bin/bash /home/xrw/moddock-nexus/app/platform/run-server.sh /home/xrw/moddock-nexus
Environment=MODDOCK_NEXUS_HOST=172.25.0.1
Environment=MODDOCK_NEXUS_IMPORT_FILE=/home/xrw/moddock-nexus/data/import-session.json
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30
MemoryHigh=192M
MemoryMax=384M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LogRateLimitIntervalSec=30
LogRateLimitBurst=50

[Install]
WantedBy=default.target
