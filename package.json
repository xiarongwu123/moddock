{
  "name": "moddock",
  "version": "0.5.0",
  "private": true,
  "description": "游匣 — 本机游戏库、社区 Mod 下载与按游戏规则安装管理",
  "main": "electron.cjs",
  "scripts": {
    "build": "node scripts/build-ui.cjs",
    "studio:setup-tools": "node scripts/setup-studio-tools.cjs",
    "studio:setup-agent": "npm ci --prefix platform --omit=dev --ignore-scripts && node scripts/check-studio-pi.cjs",
    "studio:check-agent": "node scripts/check-studio-pi.cjs",
    "prestart": "npm run build",
    "start": "electron .",
    "prepreview": "npm run build",
    "preview": "node server.cjs",
    "test": "node --test test/*.test.cjs",
    "pretest:ui": "npm run build",
    "test:ui": "node scripts/test-ui.cjs",
    "test:ui:live": "node test/ui-live.cjs",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "44.7.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/python": "1.1.19",
    "@ruby/3.3-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@xmldom/xmldom": "0.9.12",
    "face-api.js": "^0.22.2",
    "fossil-delta": "2.0.0",
    "gsap": "^3.15.0",
    "i18n-jsautotranslate": "4.0.0",
    "motion": "^14.1.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "transition-hook": "1.5.2",
    "wasmoon": "1.16.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@tensorflow/tfjs-core": {
      "node-fetch": "2.7.0"
    },
    "transition-hook": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
